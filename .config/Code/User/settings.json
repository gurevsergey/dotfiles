    "editor.tokenColorCustomizations": {
        "[Default Dark Modern]": {
            "comments": "#6b7987",
            "strings": "#95d5b2",
            "keywords": "#b49ce6",
            "numbers": "#e0a24a",
            "types": "#7fd0d6",
            "functions": "#7db4e6",
            "variables": "#e3e9ef",
            "textMateRules": [
                {
                    "scope": [
                        "constant.language",
                        "support.constant"
                    ],
                    "settings": {
                        "foreground": "#e08a4a"
                    }
                },
                {
                    "scope": [
                        "entity.name.tag",
                        "support.type.property-name"
                    ],
                    "settings": {
                        "foreground": "#7db4e6"
                    }
                },
                {
                    "scope": [
                        "entity.other.attribute-name"
                    ],
                    "settings": {
                        "foreground": "#a3cbef"
                    }
                },
                {
                    "scope": [
                        "punctuation",
                        "meta.brace"
                    ],
                    "settings": {
                        "foreground": "#93a1b0"
                    }
                },
                {
                    "scope": [
                        "markup.heading",
                        "entity.name.section"
                    ],
                    "settings": {
                        "foreground": "#e3e9ef",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "markup.inline.raw",
                        "markup.fenced_code"
                    ],
                    "settings": {
                        "foreground": "#a3cbef"
                    }
                }
            ]
        }
