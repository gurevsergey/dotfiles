/* bento · Unit-01 — как waybar и экран блокировки.
   Общий для всех меню: приложения, окна, SSH, Bluetooth, питание, next-hop (VPN).
   Старый стиль: config.rasi.bak-bento-20261125 */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "breeze-dark";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    display-drun: "󰀻  APPS";
    display-run: "  RUN";
    display-window: "󰖶  WINDOWS";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font Bold 11";
}

* {
    canvas:  #0b0b0b;
    surface: #1a1a1a;
    border:  #262626;
    ink:     #0b0b0b;
    fg:      #e8e0d0;
    fg-dim:  #a8a8a8;
    art:     #c8312b;
    main:    #e0a060;
    session: #6fa06a;
    clock:   #a8a8a8;
    danger:  #e0544a;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 640px;
    background-color: @canvas;
    border: 2px;
    border-color: @main;
    border-radius: 10px;
    padding: 12px;
}

mainbox { spacing: 10px; children: [ inputbar, message, listview, mode-switcher ]; }

inputbar {
    spacing: 8px;
    children: [ prompt, entry ];
}
prompt {
    background-color: @main;
    text-color: @ink;
    border-radius: 6px;
    padding: 9px 14px;
}
entry {
    background-color: @surface;
    border-radius: 6px;
    padding: 9px 14px;
    placeholder: "Поиск...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    cursor: text;
    cursor-color: @main;
}

message {
    background-color: @session;
    border-radius: 6px;
    padding: 8px 14px;
}
textbox { text-color: @ink; background-color: transparent; }

listview {
    lines: 8; columns: 1; spacing: 3px; scrollbar: false;
    border: 0px;
    background-color: transparent;
}

element {
    padding: 7px 12px;
    border-radius: 6px;
    spacing: 12px;
}
element-icon { size: 20px; background-color: transparent; }
element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: bold #e0a060;
}
element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @fg;
}
element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @danger;
}
element selected.normal, element selected.active {
    background-color: @main;
    text-color: @ink;
}
element selected.urgent {
    background-color: @art;
    text-color: @ink;
}
element-text selected { text-color: @ink; highlight: bold underline #0b0b0b; }

mode-switcher { spacing: 6px; }
button {
    background-color: @surface;
    text-color: @fg-dim;
    border-radius: 6px;
    padding: 6px;
}
button selected { background-color: @clock; text-color: @ink; }

error-message {
    background-color: @canvas;
    border: 2px;
    border-color: @art;
    border-radius: 10px;
    padding: 14px;
}
