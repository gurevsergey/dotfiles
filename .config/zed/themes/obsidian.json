        "border.focused": "#7b6cd9",
        "border.selected": "#7b6cd9",
        "border.transparent": "#00000000",
        "border.disabled": "#363636",
        "elevated_surface.background": "#262626",
        "surface.background": "#262626",
        "text": "#dadada",
        "text.muted": "#999999",
        "text.placeholder": "#666666",
        "text.disabled": "#666666",
        "text.accent": "#a99bf0",
        "icon": "#b3b3b3",
        "icon.muted": "#888888",
        "icon.disabled": "#666666",
        "icon.placeholder": "#888888",
        "icon.accent": "#a99bf0",
        "element.background": "#262626",
        "element.hover": "#363636",
        "element.active": "#3f3f3f",
