          "function": { "color": "#44cf6e" },
          "hint": { "color": "#999999" },
          "keyword": { "color": "#fb464c" },
          "label": { "color": "#53dfdd" },
          "link_text": { "color": "#a99bf0" },
          "link_uri": { "color": "#a99bf0", "font_style": "italic" },
          "number": { "color": "#a882ff" },
