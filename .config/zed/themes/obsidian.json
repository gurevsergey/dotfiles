        "terminal.ansi.green": "#44cf6e",
        "terminal.ansi.yellow": "#e0de71",
        "terminal.ansi.blue": "#53dfdd",
        "terminal.ansi.magenta": "#a882ff",
        "terminal.ansi.cyan": "#53dfdd",
        "terminal.ansi.white": "#dadada",
        "terminal.ansi.bright_black": "#666666",
        "terminal.ansi.bright_red": "#ff7b7f",
