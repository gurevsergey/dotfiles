titleButtonCloseFgActiveOver: titleButtonCloseFgOver; // custom window title close button icon with mouse over when window is active (Windows only)
titleFg: #6a6a6a; // custom window title text when window is inactive (macOS only)
titleFgActive: #a8a8a8; // custom window title text when window is active (macOS only)
