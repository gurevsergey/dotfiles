windowBg: #121212; // white: fallback for background
windowFg: #e8e0d0; // black: fallback for text
windowBgOver: #1f1f1f; // light gray: fallback for background with mouse over
windowBgRipple: #262626; // darker gray: fallback for ripple effect
windowFgOver: #e8e0d0; // black: fallback for text with mouse over
windowSubTextFg: #6a6a6a; // gray: fallback for additional text
windowSubTextFgOver: #a8a8a8; // darker gray: fallback for additional text with mouse over
windowBoldFg: #e8e0d0; // dark gray: fallback for bold text
windowBoldFgOver: #e8e0d0; // dark gray: fallback for bold text with mouse over
windowBgActive: #e0a060; // bright blue: fallback for blue filled active areas
windowFgActive: #0b0b0b; // white: fallback for text on active areas
windowActiveTextFg: #e0a060; // online blue: fallback for active text like online status
windowShadowFg: #000000; // black: fallback for shadow
windowShadowFgFallback: #121212; // gray: fallback for shadow without opacity
shadowFg: #0a080556; // most shadows (including opacity)
slideFadeOutBg: #0000003c; // slide animation (chat to profile) fade out filling
slideFadeOutShadowFg: windowShadowFg; // slide animation (chat to profile) fade out right section shadow
imageBg: #000000; // image background fallback (when photo size is less than minimum allowed)
imageBgTransparent: #ffffff; // image background when displaying an image with opacity where no opacity is needed
activeButtonBg: #e0a060; // default active button background
activeButtonBgOver: #f0bb85; // default active button background with mouse over
activeButtonBgRipple: #b07a42; // default active button ripple effect
activeButtonFg: #0b0b0b; // default active button text
activeButtonFgOver: #0b0b0b; // default active button text with mouse over
activeButtonSecondaryFg: #3a2a18; // default active button additional text (selected messages counter in forward / delete buttons)
activeButtonSecondaryFgOver: activeButtonSecondaryFg; // default active button additional text with mouse over
activeLineFg: #e0a060; // default active line (like code input field bottom border when you log in and field is focused)
activeLineFgError: #e0544a; // default active line for error state (like code input field bottom border when you log in and you've entered incorrect code)
lightButtonBg: #121212; // default light button background (like buttons in boxes)
lightButtonBgOver: #1f1a14; // default light button background with mouse over
lightButtonBgRipple: #2a2118; // default light button ripple effect
lightButtonFg: #e0a060; // default light button text
lightButtonFgOver: lightButtonFg; // default light button text with mouse over
attentionButtonFg: #e0544a; // default attention button text (like confirm button on log out)
attentionButtonFgOver: #e0544a; // default attention button text with mouse over
attentionButtonBgOver: #592a2a64; // default attention button background with mouse over
attentionButtonBgRipple: #68323264; // default attention button ripple effect
outlineButtonBg: windowBg; // default left outlined button background (like shared media links in profiles)
outlineButtonBgOver: #1f1f1f; // default left outlined button background with mouse over
outlineButtonOutlineFg: #e0a060; // default left outlined button left outline border
outlineButtonBgRipple: #252525; // default left outlined button ripple effect
menuBg: #1a1a1a; // default popup menu background
menuBgOver: #262626; // default popup menu item background with mouse over
menuBgRipple: #2e2e2e; // default popup menu item ripple effect
menuIconFg: #a8a8a8; // default popup menu item icon (like main menu)
menuIconFgOver: #e8e0d0; // default popup menu item icon with mouse over
menuSubmenuArrowFg: #595959; // default popup menu submenu arrow icon (like in message field context menu in case of RTL system language)
menuFgDisabled: #373737; // default popup menu item disabled text (like unavailable items in message field context menu)
menuSeparatorFg: #262626; // default popup menu separator (like in message field context menu)
scrollBarBg: #ffffff30; // default scroll bar current rectangle, the bar itself (like in chats list)
scrollBarBgOver: #ffffff55; // default scroll bar current rectangle with mouse over it
scrollBg: #ffffff0a; // default scroll bar background
scrollBgOver: #ffffff18; // default scroll bar background with mouse over the scroll bar
smallCloseIconFg: #454545; // small X icon (like in Show all sessions box to the right for sessions termination)
smallCloseIconFgOver: #aea398; // small X icon with mouse over
radialFg: #ffffff; // default radial loader line (like in Media Viewer when loading a photo)
radialBg: #00000056; // default radial loader background (like in Media Viewer when loading a photo)
placeholderFg: #6a6a6a; // default input field placeholder when field is not focused (like in phone input field when you log in)
placeholderFgActive: #424242; // default input field placeholder when field is focused
inputBorderFg: #262626; // default input field bottom border (like in code input field when you log in and field is not focused)
