filterInputInactiveBg: #1a1a1a; // default rounded input field background (like in chats list search field when field is inactive)
checkboxFg: #6a6a6a; // default unchecked checkbox rounded rectangle (and also emoji category icons)
sliderBgInactive: #323232; // default slider not active bar (like in Settings when you choose interface scale or custom notifications count)
sliderBgActive: #bc834a; // default slider active bar (like in Settings when you choose interface scale or custom notifications count)
tooltipBg: #1a1a1a; // tooltip background (like when you put mouse over the message timestamp and wait)
tooltipFg: #eadfd4; // tooltip text
tooltipBorderFg: #262626; // tooltip border
titleShadow: #00000000; // one pixel line shadow at the bottom of custom window title
